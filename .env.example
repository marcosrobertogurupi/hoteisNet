# ----------------------------------------------------
# HOTEISNET PMS SAAS - ENVIRONMENT VARIABLES
# ----------------------------------------------------

# SUPABASE POSTGRESQL & AUTH
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LOGIN / SESSAO - segredo usado para assinar o JWT do cookie de sessao (gere um valor aleatório único por ambiente)
SESSION_SECRET="generate-a-long-random-secret"

# HUB DO DESENVOLVEDOR - CONSULTA DE CPF E CNPJ
HUB_DESENVOLVEDOR_TOKEN="your-hub-desenvolvedor-token"
HUB_DESENVOLVEDOR_CONTRACT="your-hub-desenvolvedor-contract"
HUB_DEV_API_KEY="your-hub-dev-api-key"
HUB_DEV_CLIENT_ID="your-hub-dev-client-id"

# UAZAPI WHATSAPP INTEGRATION
UAZAPI_BASE_URL="https://api.uazapi.com"
UAZAPI_GLOBAL_TOKEN="your-uazapi-token"

# SNRHOS - MINISTÉRIO DO TURISMO (FNRH LEGAL)
SNRHOS_GOV_API_URL="https://snrhos.turismo.gov.br/api/v1"
SNRHOS_GOV_CERTIFICATE="your-gov-cert-token"

# AI MODELS & RAG SUPPORT (OPENAI / GEMINI)
OPENAI_API_KEY="sk-proj-your-key"
GEMINI_API_KEY="your-gemini-key"

# VERCEL & RAILWAY CLI DEPLOYMENT DEFAULTS
PORT=4000
NODE_ENV="production"
