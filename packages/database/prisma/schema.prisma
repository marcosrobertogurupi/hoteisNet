  sendReceiptEnabled        Boolean  @default(true)
  sendPaymentConfirmEnabled Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

// Configurações de disparo automático de mensagens de WhatsApp para o hóspede, por assinante.
// Cobre os 4 eventos do ciclo de hospedagem: confirmação de reserva, boas-vindas no check-in,
// aviso de previsão de check-out (disparado pelo worker num horário fixo) e aviso de check-out.
model WhatsappMessageSetting {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  reservationConfirmEnabled Boolean  @default(true)
  reservationConfirmMessage String   @default("Foi efetuado uma reserva. Segue anexo o PDF com o voucher.") @db.Text
  checkinWelcomeEnabled     Boolean  @default(true)
  checkinWelcomeMessage     String   @default("*Bem-vindo(a) ao {HOTEL}!*\n\nDesejamos a você uma excelente estadia. Qualquer necessidade, estamos à disposição na recepção.") @db.Text
  checkoutPrevisionEnabled  Boolean  @default(false)
  checkoutPrevisionMessage  String   @default("Olá {HOSPEDE}, lembramos que o check-out do quarto {QUARTO} está previsto para hoje. Contamos com você!") @db.Text
  checkoutPrevisionTime     String   @default("10:00")
  checkoutEnabled           Boolean  @default(false)
  checkoutMessage           String   @default("Checkout feito com sucesso. Esperamos que seja breve o seu retorno.") @db.Text
  preCheckinFnrhEnabled     Boolean  @default(true)
  preCheckinFnrhMessage     String   @default("Olá {HOSPEDE}! Faltam poucas horas para sua chegada ao {HOTEL}. Para agilizar seu check-in, preencha seus dados no link abaixo:\n{LINK}") @db.Text
  preCheckinFnrhHoursBefore Int      @default(3)
  updatedAt                 DateTime @updatedAt
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_message_settings")
}

model Tariff {
