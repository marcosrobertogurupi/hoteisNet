generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SaaSPlan {
  id            String             @id @default(uuid())
  name          String             @unique
  description   String?
  priceMonthly  Decimal            @db.Decimal(10, 2)
  maxRooms      Int
  maxUsers      Int
  aiTokenQuota  Int                @default(50000)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions SaASSubscription[]

  @@map("saas_plans")
}

// Tabela de referência nacional (municípios do IBGE), compartilhada por todos os assinantes —
// não é isolada por tenantId, ao contrário dos demais cadastros do sistema, porque o código IBGE
// de um município é sempre o mesmo independente de qual hotel está usando o sistema. Importada a
// partir da tabela CidadesNet do sistema legado em WinDev (ver script de importação em
// packages/database/scripts/import-municipalities.js). Usada para resolver o campo cidade_id
// exigido pela API do SNRHos (ver apps/web/src/lib/snrhosClient.ts).
model Municipality {
  id        String   @id @default(uuid())
  name      String
  ibgeCode  String   @unique
  uf        String
  dddCode   String?
  country   String   @default("Brasil")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([uf])
  @@map("municipalities")
}

model Tenant {
  id                         String                  @id @default(uuid())
  name                       String
  tradeName                  String?
  cnpj                       String?                 @unique
  cadastur                   String?
  status                     TenantStatus            @default(TRIAL)
  email                      String
  phone                      String?
  // Endereço estruturado do hotel — equivalente aos campos Hot_Logradouro/Hot_Numero/Hot_Bairro/
  // Hot_Cidade/Hot_UF/Hot_CEP da tabela Hotel.fic do sistema legado WinDev (ver memória
  // tenant-is-the-windev-hotel-cadastro). `address` (texto livre) está deprecado — usar os campos
  // estruturados; tenantHeader.ts monta a linha de endereço a partir deles.
  street                     String?
  number                     String?
  neighborhood               String?
  city                       String?
  state                      String?
  address                    String? // DEPRECADO — usar street/number/neighborhood
  zipCode                    String?
  // Inscrição Estadual (Hot_IE) e regime tributário (Hot_Regime: 01 Simples Nacional / 02 Lucro
  // Presumido / 03 Lucro Real / 04 MEI). Editáveis pelo assinante em Configurações > Dados do Hotel.
  stateRegistration          String?
  taxRegime                  TaxRegime?
  // Site do hotel (Hot_Site) e percentual de juros de mora para títulos em atraso (Hot_Juros).
  website                    String?
  interestRate               Decimal?                @db.Decimal(5, 2)
  logoUrl                    String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  dailyRolloverTime          String                  @default("14:30")
  allowNegativeStock         Boolean                 @default(false)
  breakfastHours             String? // ex: "07:00 às 10:00" — horário padrão (seg-sáb), usado pelo agente de atendimento (get_hotel_info)
  // Horário do café da manhã aos domingos e feriados, quando difere do padrão (comum em hotéis/pousadas).
  // Opcional: se ficar vazio, o agente usa breakfastHours para todos os dias. Ver get_hotel_info / Configurações.
  breakfastHoursHoliday      String?
  cpfQueryQuotaMonthly       Int                     @default(100)
  cpfQueryUsed               Int                     @default(0)
  cpfQueryCycleStart         DateTime                @default(now())
  // Liga/desliga o serviço de consulta de CPF (Hub do Desenvolvedor) por assinante — controle
  // exclusivo do Painel SuperAdmin, distinto da cota mensal: um assinante pode ter cota > 0 e
  // ainda assim estar com o recurso desabilitado no plano contratado.
  cpfQueryEnabled            Boolean                 @default(true)
  // Percentual máximo de desconto que um operador comum pode aplicar no check-in sem autorização
  // de administrador (ShieldCheck/AdminAuthorizationModal). Configurável pelo próprio assinante em
  // Configurações — acima desse percentual, exige senha de admin, igual à cortesia de madrugada.
  maxDiscountPercent         Decimal                 @default(20) @db.Decimal(5, 2)
  // Exige preenchimento + assinatura da FNRH pelo hóspede antes de liberar o check-in (reserva ou
  // avulso). Configurável pelo assinante em Configurações — default false preserva o comportamento atual.
  fnrhMandatoryBeforeCheckin Boolean                 @default(false)
  // Minutos de inatividade (sem mouse/teclado) até a tela travar e exigir novo login. 0 = desativado.
  // Configurável só pelo admin em Configurações. Serve também para troca rápida de operador no terminal
  // (quem autenticar na tela de bloqueio assume a sessão). Ver components/InactivityLock.tsx.
  screenLockMinutes          Int                     @default(0)
  // Horários padrão da propriedade (Configurações → "Horários Padrão de Check-in e Check-out").
  // Antes viviam só no localStorage do navegador; agora persistidos no Tenant porque o backend
  // precisa deles para validar chegada antecipada dentro da transação do check-in (o cliente
  // nunca informa o horário-limite, senão bastaria mandar "00:00" para escapar da penalidade).
  standardCheckInTime          String                @default("14:00")
  standardCheckOutTime         String                @default("12:00")
  // Janela de tolerância (minutos antes de standardCheckInTime) em que a chegada NÃO gera cobrança
  // de chegada antecipada — cobre a recepção que processa o check-in um pouco antes do horário.
  // O horário real da chegada é sempre gravado; a tolerância só isenta a cobrança.
  earlyCheckinToleranceMinutes Int                   @default(60)
  // Cobrança padrão pré-selecionada quando o hóspede chega ANTES do horário padrão (fora da
  // tolerância) mas depois do corte de madrugada: EXTRA_NIGHT (1 diária), HALF_NIGHT (meia),
  // FIXED_FEE (valor fixo em earlyCheckinFixedFeeAmount). Cortesia sempre exige senha de admin.
  earlyArrivalDefaultCharge    String                @default("EXTRA_NIGHT")
  // Cobrança padrão pré-selecionada para chegada de madrugada (antes do corte, MADRUGADA_CUTOFF_TIME).
  overnightArrivalDefaultCharge String               @default("EXTRA_NIGHT")
  // Valor usado quando *DefaultCharge = FIXED_FEE.
  earlyCheckinFixedFeeAmount   Decimal               @default(0) @db.Decimal(10, 2)
  // Texto informativo da política de chegada antecipada exibido ao hóspede (voucher/pré-check-in) —
  // a Portaria MTur 28/2025 exige que qualquer cobrança de early check-in seja informada previamente.
  earlyCheckinPolicyText       String?
  accountPlans               AccountPlan[]
  aiAgentSettings            AIAgentSetting?
  aiUsageLogs                AIUsageLog[]
  cashRegisters              CashRegister[]          @relation("TenantCashRegisters")
  companies                  Company[]
  banks                      Bank[]
  employees                  Employee[]
  productGroups              ProductGroup[]
  productTypes               ProductType[]
  dishes                     Dish[]
  hotelTables                HotelTable[]
  emailSettings              EmailSetting?
  floors                     Floor[]
  guests                     Guest[]
  housekeepers               Housekeeper[]
  housekeepingTasks          HousekeepingTask[]
  housekeepingSettings       HousekeepingSetting?
  paymentMethods             PaymentMethod[]
  accountsReceivable         AccountsReceivable[]
  accountsPayable            AccountsPayable[]
  guestBalanceEntries        GuestBalanceEntry[]
  posLocations               POSLocation[]
  products                   Product[]
  reservations               Reservation[]           @relation("TenantReservations")
  roomCategories             RoomCategory[]
  rooms                      Room[]
  occupancySnapshots         RoomOccupancySnapshot[]
  subscriptions              SaASSubscription[]
  preCheckinLinks            PreCheckinLink[]
  checkins                   StayCheckin[]
  debitTransfers             StayDebitTransfer[]
  suppliers                  Supplier[]
  supportTickets             SupportTicket[]
  supportKnowledgeBase       SupportKnowledgeBase[]
  knowledgeTopics            HotelKnowledgeTopic[]
  knowledgeRevisions         KnowledgeRevision[]
  operationalAlertLogs       OperationalAlertLog[]
  humanEscalations           HumanEscalation[]
  hotelServices              HotelService[]
  tariffs                    Tariff[]
  activityLogs               AuditLog[]
  uazapiSettings             UazapiSetting?
  snrhosSettings             SNRHosSetting?
  users                      User[]
  vehicles                   Vehicle[]
  whatsappMessageSettings    WhatsappMessageSetting?
  whatsappMessages           WhatsappMessage[]
  conversationMemories       ConversationMemory[]
  fiscalConfig               FiscalConfig?
  pdvTerminals               PdvTerminal[]
  fiscalSequences            FiscalSequence[]
  fiscalProfiles             FiscalProfile[]
  comandas                   Comanda[]
  comandaSessions            ComandaSession[]
  comandaDebitTransfers      ComandaDebitTransfer[]
  fiscalDocuments            FiscalDocument[]
  stockCounts                StockCount[]

  @@map("tenants")
}

model SaASSubscription {
  id          String   @id @default(uuid())
  tenantId    String
  planId      String
  startDate   DateTime @default(now())
  nextBilling DateTime
  amount      Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        SaaSPlan @relation(fields: [planId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("saas_subscriptions")
}

model User {
  id                  String          @id @default(uuid())
  tenantId            String?
  email               String          @unique
  name                String
  passwordHash        String
  role                UserRole        @default(RECEPCIONIST)
  avatarUrl           String?
  active              Boolean         @default(true)
  // Incrementado ao desativar o usuário, trocar senha ou mudar o role — invalida instantaneamente
  // qualquer JWT de sessão já emitido antes da mudança (ver getSessionUser em lib/auth.ts).
  tokenVersion        Int             @default(0)
  // Proteção contra força bruta no login (ver checkAndRegisterLoginAttempt em lib/auth.ts).
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  sentTickets         SupportTicket[] @relation("TicketAuthor")
  tenant              Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs           AuditLog[]

  @@map("users")
}

model AIUsageLog {
  id           String   @id @default(uuid())
  tenantId     String
  feature      String
  tokensInput  Int
  tokensOutput Int
  totalCostUsd Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_usage_logs")
}

// Trilha de auditoria: registra quem fez o quê, quando e de qual terminal/IP, para
// investigação posterior (ex.: "quem fez o check-out do quarto 106 e às 14h32 de qual estação").
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  userName    String?
  action      String
  description String?
  entityType  String?
  entityId    String?
  terminal    String?
  ipAddress   String?
  details     Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@map("tenant_activity_logs")
}

model SupportTicket {
  id         String          @id @default(uuid())
  tenantId   String
  authorId   String
  subject    String
  category   String
  priority   TicketPriority  @default(MEDIUM)
  status     TicketStatus    @default(OPEN)
  aiResolved Boolean         @default(false)
  confidence Float?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  author     User            @relation("TicketAuthor", fields: [authorId], references: [id])
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderType String
  senderName String
  content    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

// Base de conhecimento por tenant que os dois agentes de IA consultam antes de responder/alertar —
// o mecanismo de "aprendizado" deles (não é re-treino do modelo, é RAG leve: pergunta+resposta
// salva quando um humano resolve algo que o agente não soube, consultada em conversas parecidas
// no futuro). Ver Fase G em PLANO_AGENTE_IA.md.
model SupportKnowledgeBase {
  id             String               @id @default(uuid())
  tenantId       String
  agentType      KnowledgeAgentType   @default(SUPPORT)
  // MANUAL | HUMAN_CORRECTION | ESCALATION_RESOLVED | ESCALATION_SUGGESTED
  // ESCALATION_SUGGESTED = rascunho criado pelo agente ao escalar por não saber algo; nasce com
  // status PENDING_REVIEW e só é consultado pelos agentes depois que um humano aprova (status ACTIVE).
  sourceType     String               @default("MANUAL")
  title          String
  category       String
  // Categorização opcional numa das 12 áreas canônicas de dúvida do hóspede (ver HotelKnowledgeTopic).
  topicKey       KnowledgeTopicKey?
  question       String
  resolution     String
  // Substitui o antigo booleano `verified`: ACTIVE = aprovada e usada pelos agentes;
  // PENDING_REVIEW = sugestão do agente aguardando um humano; ARCHIVED = desativada sem apagar.
  status         KnowledgeEntryStatus @default(ACTIVE)
  verified       Boolean              @default(true)
  lastReviewedAt DateTime?
  updatedByName  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentType])
  @@index([tenantId, status])
  @@map("support_knowledge_base")
}

enum KnowledgeAgentType {
  SUPPORT
  OPERATIONAL
}

// As 12 áreas canônicas de dúvida de hóspede no atendimento por WhatsApp (levantamento do setor,
// ver o markdown de origem em PLANO_AGENTE_IA.md / Base de Conhecimento). Cada tenant tem um
// HotelKnowledgeTopic por chave, com um texto livre que o hotel mantém e que o agente de
// atendimento consulta antes de responder.
enum KnowledgeTopicKey {
  RESERVA_PRECO
  CANCELAMENTO
  CHECKIN_CHECKOUT
  LOCALIZACAO_ACESSO
  QUARTO_COMODIDADES
  REGRAS_CRIANCAS_PETS
  PAGAMENTO_TAXAS
  SERVICOS_HORARIOS
  PEDIDOS_ESPECIAIS_ACESSIBILIDADE
  PROBLEMAS_ESTADIA
  BAGAGEM_ENCOMENDAS
  RECOMENDACOES_LOCAIS
}

enum KnowledgeEntryStatus {
  ACTIVE
  PENDING_REVIEW
  ARCHIVED
}

// Quem originou uma alteração registrada em KnowledgeRevision.
enum KnowledgeChangeSource {
  MANUAL
  AGENT_SUPPORT
  AGENT_OPERATIONAL
}

// Documento por tópico que o hotel mantém — o "manual" que o agente de atendimento consulta.
// Uma linha por (tenant, topicKey), semeada com um texto-guia na primeira vez que a tela é aberta
// (ver ensureKnowledgeTopics). `content` é texto livre; o agente recebe apenas trechos relevantes,
// truncados, via a tool search_knowledge_base — nunca o documento inteiro (controle de custo/prompt).
model HotelKnowledgeTopic {
  id                 String            @id @default(uuid())
  tenantId           String
  topicKey           KnowledgeTopicKey
  title              String
  content            String            @default("")
  active             Boolean           @default(true)
  // Última vez que um humano confirmou que o conteúdo está atualizado ("Marcar como revisado") —
  // o Agente Operacional alerta quando isso fica mais velho que AIAgentSetting.knowledgeReviewIntervalDays.
  lastReviewedAt     DateTime?
  lastReviewedByName String?
  updatedByName      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, topicKey])
  @@map("hotel_knowledge_topics")
}

// Histórico append-only de toda alteração de conteúdo da base de conhecimento (tópicos e entradas),
// para auditoria e para o "Desfazer" de 1 clique — inclusive as edições automáticas feitas pelo
// Agente Operacional (changeSource = AGENT_OPERATIONAL), que ficam destacadas na tela.
model KnowledgeRevision {
  id            String                @id @default(uuid())
  tenantId      String
  targetType    String // "TOPIC" | "ENTRY"
  targetId      String
  contentBefore String
  contentAfter  String
  changeSource  KnowledgeChangeSource @default(MANUAL)
  changedByName String
  reason        String?
  reverted      Boolean               @default(false)
  createdAt     DateTime              @default(now())
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetType, targetId])
  @@index([tenantId, createdAt])
  @@map("knowledge_revisions")
}

model RoomCategory {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  // Preenchidos hoje por padrão; o valor real da diária e a capacidade de hóspedes
  // são definidos no cadastro de Tarifas, não neste pré-cadastro de categoria.
  dailyPrice  Decimal          @default(0) @db.Decimal(10, 2)
  capacity    Int              @default(1)
  description String?
  active      Boolean          @default(true)
  // LODGING = quarto de hospedagem normal. EVENT_SPACE = auditório, sala de reunião, espaço para
  // palestras etc. — NÃO é vendido como diária pelo agente de atendimento (ver
  // apps/web/src/lib/aiAgent/tools.ts): fica de fora da disponibilidade de quartos e qualquer
  // pedido de reserva desse tipo é encaminhado para a recepção.
  kind        RoomCategoryKind @default(LODGING)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms       Room[]

  @@map("room_categories")
}

// Serviços prestados pelo hotel (lavanderia, traslado, cama extra, estacionamento etc.) —
// substitui a tela mock anterior de cadastros/servicos. Também consultado pelo agente de
// atendimento via tool list_services.
model HotelService {
  id          String   @id @default(uuid())
  tenantId    String
  code        String?
  description String
  category    String?
  price       Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("hotel_services")
}

model PaymentMethod {
  id                 String  @id @default(uuid())
  tenantId           String
  description        String
  // Parcelamento = ao lançar um pagamento com esta forma, o valor vai para o contas a receber
  // (AccountsReceivable) em vez de ser quitado em caixa — ver apps/web/src/lib/paymentProcessing.ts.
  installment        Boolean @default(false)
  // Debitar Saldo Hóspede = ao usar esta forma, o sistema consulta e debita o saldo disponível
  // do hóspede (Guest.balance / GuestBalanceEntry) — ver apps/web/src/lib/paymentProcessing.ts.
  debitGuestBalance  Boolean @default(false)
  // Transf.Débito = o valor lançado nesta forma é transferido para outro quarto ocupado. Fluxo
  // dedicado em /api/stay/transfer-debit; formas com esta flag são ocultadas do seletor normal
  // de pagamento (ver LancarPagamentoHospedagemModal.tsx).
  transferDebit      Boolean @default(false)
  // true = Soma Caixa (lança e soma nos totais do caixa); false = Conta Corrente
  // (apenas informa o lançamento, sem somar nos totais). Mutuamente exclusivos por natureza.
  sumsToCashRegister Boolean @default(true)
  active             Boolean @default(true)
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model AccountsReceivable {
  id                       String                 @id @default(uuid())
  tenantId                 String
  stayCheckinId            String
  companyId                String?
  guestId                  String?
  billedToName             String
  documentNumber           String
  issueDate                DateTime               @default(now())
  dueDate                  DateTime
  amount                   Decimal                @db.Decimal(10, 2)
  amountPaid               Decimal                @default(0) @db.Decimal(10, 2)
  isPaid                   Boolean                @default(false)
  paidAt                   DateTime?
  paymentMethodDescription String
  notes                    String?
  createdAt                DateTime               @default(now())
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stayCheckin              StayCheckin            @relation(fields: [stayCheckinId], references: [id])
  company                  Company?               @relation(fields: [companyId], references: [id])
  guest                    Guest?                 @relation(fields: [guestId], references: [id])
  settlements              ReceivableSettlement[]

  @@map("accounts_receivable")
}

model ReceivableSettlement {
  id                       String             @id @default(uuid())
  accountsReceivableId     String
  amount                   Decimal            @db.Decimal(10, 2)
  interest                 Decimal            @default(0) @db.Decimal(10, 2)
  discount                 Decimal            @default(0) @db.Decimal(10, 2)
  paymentMethodDescription String
  paidAt                   DateTime           @default(now())
  operatorId               String?
  operatorName             String?
  accountsReceivable       AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Cascade)

  @@map("receivable_settlements")
}

// Contas a Pagar — equivalente ao fichier Pagar do sistema legado WinDev (telas Win_ContasPagar e
// Win_GerarContasPagar). Mesma estrutura de Contas a Receber, mas ligado a Fornecedores em vez de
// Hóspedes/Empresas, com o Plano de Contas de despesa (Pag_PlContas/Pag_IDPLC no legado) informando
// em qual conta contábil o débito deve ser lançado.
model AccountsPayable {
  id              String              @id @default(uuid())
  tenantId        String
  supplierId      String?
  supplierName    String
  documentNumber  String
  originDocument  String?
  accountPlanId   String?
  accountPlanCode String?
  issueDate       DateTime            @default(now())
  dueDate         DateTime
  amount          Decimal             @db.Decimal(10, 2)
  amountPaid      Decimal             @default(0) @db.Decimal(10, 2)
  isPaid          Boolean             @default(false)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime            @default(now())
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  accountPlan     AccountPlan?        @relation(fields: [accountPlanId], references: [id])
  settlements     PayableSettlement[]

  @@map("accounts_payable")
}

model PayableSettlement {
  id                       String          @id @default(uuid())
  accountsPayableId        String
  amount                   Decimal         @db.Decimal(10, 2)
  interest                 Decimal         @default(0) @db.Decimal(10, 2)
  discount                 Decimal         @default(0) @db.Decimal(10, 2)
  paymentMethodDescription String
  paidAt                   DateTime        @default(now())
  operatorId               String?
  operatorName             String?
  accountsPayable          AccountsPayable @relation(fields: [accountsPayableId], references: [id], onDelete: Cascade)

  @@map("payable_settlements")
}

// Ledger de crédito/débito do saldo do hóspede — equivalente a HospedeNetMov do sistema legado.
// Guest.balance é o saldo consolidado; estas entradas são o histórico auditável que o compõe.
model GuestBalanceEntry {
  id                       String       @id @default(uuid())
  tenantId                 String
  guestId                  String
  stayCheckinId            String?
  type                     String // "CREDITO" | "DEBITO"
  amount                   Decimal      @db.Decimal(10, 2)
  paymentMethodDescription String?
  operatorId               String?
  operatorName             String?
  description              String?
  createdAt                DateTime     @default(now())
  tenant                   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest                    Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  stayCheckin              StayCheckin? @relation(fields: [stayCheckinId], references: [id])

  @@map("guest_balance_entries")
}

// Pré-cadastro de Andares: cada assinante (tenant) define os andares do seu próprio
// hotel antes de poder selecioná-los no cadastro de Apartamentos (UH).
model Floor {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("floors")
}

model Room {
  id                String             @id @default(uuid())
  tenantId          String
  categoryId        String
  number            String
  floor             String?
  bloco             String?
  camasCasal        Int                @default(0)
  camasSolteiro     Int                @default(0)
  caracteristicas   String[]           @default([])
  photos            String[]           @default([])
  status            RoomStatus         @default(VACANT_CLEAN)
  notes             String?
  active            Boolean            @default(true)
  // Última alteração no registro do quarto (Prisma atualiza em qualquer campo, não só status) —
  // usado como aproximação pelo Agente Operacional para detectar quarto parado em manutenção ou
  // limpeza há tempo demais (ver apps/worker/src/operationalAgent.ts).
  updatedAt         DateTime           @default(now()) @updatedAt
  reservations      Reservation[]
  category          RoomCategory       @relation(fields: [categoryId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkins          StayCheckin[]
  housekeepingTasks HousekeepingTask[]

  @@map("rooms")
}

// Governanta/camareira responsável pela limpeza dos quartos. Login próprio (WhatsApp + senha),
// separado do login administrativo (User), usado pelo app mobile de governança.
model Housekeeper {
  id                  String             @id @default(uuid())
  tenantId            String
  name                String
  whatsapp            String
  photoUrl            String?
  passwordHash        String
  active              Boolean            @default(true)
  // Proteção contra força bruta no login (ver checkAndRegisterLoginAttempt em lib/auth.ts).
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  housekeepingTasks   HousekeepingTask[]

  @@unique([tenantId, whatsapp])
  @@map("housekeepers")
}

// Uma limpeza (ciclo completo) de um quarto. Nunca é sobrescrita — cada limpeza gera um novo
// registro, formando o histórico de duração/observações usado no acompanhamento do painel.
model HousekeepingTask {
  id              String                 @id @default(uuid())
  tenantId        String
  roomId          String
  housekeeperId   String?
  // CHECKOUT: limpeza profunda de quarto vago após check-out (pode entrar na fila automática no
  // modo QUEUE). OCCUPIED: arrumação de quarto com hóspede hospedado — no modo RECEPTION é sempre
  // atribuída manualmente pela recepção; no modo QUEUE é gerada automaticamente uma por dia por
  // quarto ocupado (ver ensureDailyArrumacaoTasks em apps/web/src/lib/housekeeping.ts).
  type            HousekeepingTaskType   @default(CHECKOUT)
  status          HousekeepingTaskStatus @default(PENDING)
  // Preenchido só quando status = SKIPPED — motivo de a arrumação ter sido encerrada sem limpeza
  // (ex.: hóspede em "não perturbe", reportado pela própria governanta no app dela).
  skipReason      HousekeepingSkipReason?
  notes           String?
  assignedAt      DateTime?
  startedAt       DateTime?
  // Momento em que a tarefa foi encerrada — vale para DONE (limpou) e para SKIPPED (não limpou).
  finishedAt      DateTime?
  durationSeconds Int?
  // Dia (meia-noite de Brasília, ver lib/brasiliaDate.ts) ao qual a arrumação diária pertence.
  // Só é preenchido nas tarefas OCCUPIED geradas automaticamente no modo QUEUE — NULL para
  // limpeza pós check-out e para atribuições manuais da recepção. O @@unique abaixo garante no
  // máximo uma arrumação diária por quarto por dia (múltiplos NULL não colidem no Postgres).
  serviceDate     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room            Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  housekeeper     Housekeeper?           @relation(fields: [housekeeperId], references: [id])

  @@unique([roomId, type, serviceDate])
  @@index([tenantId, status])
  @@index([roomId, status])
  @@index([tenantId, serviceDate])
  @@map("housekeeping_tasks")
}

// Parametrização por assinante de como os quartos são atribuídos às governantas (ver app/settings).
model HousekeepingSetting {
  id             String                     @id @default(uuid())
  tenantId       String                     @unique
  assignmentMode HousekeepingAssignmentMode @default(RECEPTION)
  // Só valem no modo QUEUE. autoDailyArrumacao: gera automaticamente uma arrumação por dia para
  // cada quarto ocupado. arrumacaoSkipCheckinDay: não gera arrumação no próprio dia do check-in
  // (o quarto acabou de ser preparado para a chegada).
  autoDailyArrumacao      Boolean            @default(true)
  arrumacaoSkipCheckinDay Boolean            @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("housekeeping_settings")
}

// Histórico de taxa de ocupação do hotel, gravado a cada hora (ver apps/worker/src/occupancySnapshot.ts),
// usado para estatísticas de vacância ao longo do tempo.
model RoomOccupancySnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  snapshotAt    DateTime @default(now())
  totalRooms    Int
  occupiedRooms Int
  occupancyRate Decimal  @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, snapshotAt])
  @@map("room_occupancy_snapshots")
}

model Company {
  id                  String               @id @default(uuid())
  tenantId            String
  name                String
  tradeName           String?
  cnpj                String
  ie                  String?
  email               String?
  phone               String?
  address             String?
  number              String?
  complement          String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?
  billingZipCode      String?
  billingAddress      String?
  billingNumber       String?
  billingComplement   String?
  billingNeighborhood String?
  billingCity         String?
  billingState        String?
  phones              Json?
  emails              Json?
  notes               String?              @db.Text
  creditLimit         Decimal?             @db.Decimal(10, 2)
  paymentTerms        Int                  @default(15)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices            CorporateInvoice[]
  guests              Guest[]              @relation("GuestCompanyLink")
  receivables         AccountsReceivable[]

  @@map("companies")
}

model Guest {
  id             String               @id @default(uuid())
  tenantId       String
  companyId      String?
  fullName       String
  cpf            String?
  passport       String?
  birthDate      DateTime?
  gender         String?
  email          String?
  phone          String?
  whatsappPhone  String?
  nomeUsuarioWpp String?
  whatsappName   String?
  hasWhatsapp    Boolean              @default(false)
  zipCode        String?
  street         String?
  number         String?
  neighborhood   String?
  city           String?
  state          String?
  country        String               @default("Brasil")
  // Nome completo dos pais e endereço já formatado, obtidos na consulta de CPF ao Hub do
  // Desenvolvedor (ou digitados manualmente) e gravados no check-in — antes eram exibidos na
  // tela e descartados ao confirmar a hospedagem. fullAddress é redundante com os campos
  // estruturados acima de propósito: é o texto pronto retornado pelo Hub, sem risco de um
  // parser quebrar o endereço estruturado de um cadastro já existente.
  motherName     String?
  fatherName     String?
  fullAddress    String?
  // Campos exigidos pela FNRH (Ficha Nacional de Registro de Hóspedes / SNRHos) além do
  // cadastro comercial básico já existente acima. `country` continua sendo o país do endereço
  // (nome livre, ex: "Brasil"); `nationality` é a nacionalidade do hóspede em si (podem
  // divergir) e é armazenada como código ISO 3166-1 alpha-2 (ex: "BR", "US") porque é o formato
  // exigido pela API do SNRHos (campo PaisNacionalidade_id) — ver apps/web/src/lib/snrhosClient.ts.
  rgNumber       String?
  rgIssuer       String?
  rgIssuerState  String?
  nationality    String?              @default("BR")
  raceColor      String?
  occupation     String?
  // Campos de deficiência exigidos pela FNRH/SNRHos (domínios opcao_deficiencia/tipos_deficiencia).
  disability     String?              @default("NAOINFORMAR")
  disabilityType String?
  // Saldo credor consolidado do hóspede — ver GuestBalanceEntry para o ledger de auditoria
  // (créditos/débitos) que compõe este valor. Equivalente ao conceito de HospedeNetMov do
  // sistema legado.
  balance        Decimal              @default(0) @db.Decimal(10, 2)
  fnrhRecords    FNRHRecord[]
  company        Company?             @relation("GuestCompanyLink", fields: [companyId], references: [id])
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkins       StayCheckin[]
  vehicles       Vehicle[]
  balanceEntries GuestBalanceEntry[]
  receivables    AccountsReceivable[]

  @@map("guests")
}

model Vehicle {
  id             String   @id @default(uuid())
  tenantId       String
  guestId        String
  placa          String
  caracteristica String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId, guestId])
  @@map("vehicles")
}

model FNRHRecord {
  id                     String       @id @default(uuid())
  guestId                String
  stayCheckinId          String?
  // Vínculo com a reserva de origem: o pré-check-in é preenchido pelo hóspede horas ANTES da
  // chegada, quando a StayCheckin ainda não existe. stayCheckinId só passa a ser preenchido
  // quando o check-in físico acontece de fato; reservationId é o vínculo estável desde o início.
  reservationId          String?
  travelReason           String
  transportMode          String
  lastOriginCity         String
  lastOriginState        String
  lastOriginCountry      String       @default("Brasil")
  nextDestinationCity    String
  nextDestinationState   String
  nextDestinationCountry String       @default("Brasil")
  signatureUrl           String?
  transmittedSNRHos      Boolean      @default(false)
  transmittedAt          DateTime?
  // IDs devolvidos pelo SNRHos em POST /hospedagem/registrar — necessários para futuras
  // atualizações de situação (PATCH /hospedes/{id}/checkin|checkout) e para diagnosticar
  // reenvios. snrhosLastError guarda a última falha (sem preencher em caso de sucesso).
  snrhosReservaId        String?
  snrhosHospedeId        String?
  snrhosPessoaId         String?
  snrhosLastError        String?
  snrhosAttempts         Int          @default(0)
  createdAt              DateTime     @default(now())
  guest                  Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  stayCheckin            StayCheckin? @relation(fields: [stayCheckinId], references: [id])
  reservation            Reservation? @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@map("fnrh_records")
}

model Reservation {
  id                     String            @id @default(uuid())
  tenantId               String
  roomId                 String
  guestName              String
  guestPhone             String?
  checkInDate            DateTime
  checkOutDate           DateTime
  totalAmount            Decimal           @db.Decimal(10, 2)
  depositPaid            Decimal           @default(0) @db.Decimal(10, 2)
  status                 ReservationStatus @default(PRE_RESERVATION)
  preCheckinSent         Boolean           @default(false)
  createdAt              DateTime          @default(now())
  // Última alteração no registro (Prisma bumpa em qualquer campo). Usado pelo polling dos mapas
  // como parte do "carimbo de versão" que decide se o Mapa de Reservas precisa rebaixar o payload
  // ou pode receber um 304 (ver apps/web/src/lib/mapVersion.ts).
  updatedAt              DateTime          @default(now()) @updatedAt
  guestId                String?
  tariffId               String?
  tariffName             String?
  guestCpf               String?
  dailyRate              Decimal?          @default(0) @db.Decimal
  totalDiarias           Decimal?          @default(0) @db.Decimal
  discountAmount         Decimal?          @default(0) @db.Decimal
  cashRegisterId         String?
  operatorName           String?
  notes                  String?
  adults                 Int?              @default(1)
  children               Int?              @default(0)
  hasWhatsapp            Boolean?          @default(false)
  wppSent                Boolean?          @default(false)
  reservationNumber      String?
  roomDescription        String?
  roomCategory           String?
  roomFloor              String?
  // Marca quando o agente de IA (WhatsApp) registrou um pedido de cancelamento ainda não
  // confirmado pelo hóspede — ver cancelReservationForAgent em apps/web/src/lib/aiAgent/tools.ts.
  // A primeira chamada da tool cancel_reservation só grava este timestamp e pede confirmação; o
  // cancelamento de fato só ocorre numa segunda chamada, dentro da janela de expiração, para a
  // mesma reserva. Nulo fora desse fluxo (nunca usado pelo cancelamento manual da tela de admin).
  agentCancelRequestedAt DateTime?
  room                   Room              @relation(fields: [roomId], references: [id])
  tenant                 Tenant            @relation("TenantReservations", fields: [tenantId], references: [id], onDelete: Cascade)
  stayCheckin            StayCheckin?
  fnrhRecords            FNRHRecord[]
  preCheckinLinks        PreCheckinLink[]

  @@map("reservations")
}

// Token de acesso público e de uso único para o hóspede preencher o pré-check-in/FNRH pelo
// celular antes de chegar ao hotel. Token opaco em banco (não JWT) para permitir revogação e
// controle de estado explícito (reenvio invalida o link anterior), no mesmo padrão de
// UazapiSetting/WhatsappMessageSetting de modelar estado em tabela.
model PreCheckinLink {
  id            String      @id @default(uuid())
  tenantId      String
  reservationId String
  token         String      @unique
  status        String      @default("PENDING") // PENDING | OPENED | COMPLETED | EXPIRED | REVOKED
  expiresAt     DateTime
  openedAt      DateTime?
  completedAt   DateTime?
  sentAt        DateTime?
  sendAttempts  Int         @default(0)
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("pre_checkin_links")
}

model StayCheckin {
  id                        String               @id @default(uuid())
  tenantId                  String
  roomId                    String
  primaryGuestId            String
  reservationId             String?              @unique
  checkInDate               DateTime             @default(now())
  expectedCheckOut          DateTime
  actualCheckOut            DateTime?
  billingType               String               @default("DIRECT")
  totalDaily                Decimal              @db.Decimal(10, 2)
  totalConsumption          Decimal              @default(0) @db.Decimal(10, 2)
  discount                  Decimal              @default(0) @db.Decimal(10, 2)
  adults                    Int                  @default(1)
  children                  Int                  @default(0)
  isClosed                  Boolean              @default(false)
  dailiesCount              Int                  @default(1)
  lastRolloverDate          DateTime             @default(now())
  checkoutPrevisionSentDate String?
  // Diárias lançadas por virada automática além da previsão original de saída (expectedCheckOut) —
  // equivalente a hpd_qtddiariasextras do sistema legado. dailiesCount continua sendo o total geral.
  extraDailiesCount         Int                  @default(0)
  // Snapshot de auditoria: quem fez o check-in/check-out desta hospedagem e quem operava o caixa
  // no momento do fechamento financeiro — equivalentes a hpd_idusucheckin/hpd_idusucheckout/hpd_operadorfechou.
  checkedInByUserId         String?
  checkedInByUserName       String?
  checkedOutByUserId        String?
  checkedOutByUserName      String?
  closingOperatorId         String?
  closingOperatorName       String?
  // Cancelamento da hospedagem em si (distinto de um check-out normal) — equivalente a
  // hpd_idusucancelam. Ainda sem fluxo de UI que grave estes campos.
  isCanceled                Boolean              @default(false)
  canceledAt                DateTime?
  canceledByUserId          String?
  canceledByUserName        String?
  // Totais financeiros consolidados na própria hospedagem (equivalentes a hpd_totaladiant,
  // hpd_saldopagar e hpd_outrosdeb) — recalculados a cada pagamento/fechamento em vez de
  // apenas derivados on-the-fly, para preservar o valor histórico mesmo após a hospedagem fechar.
  totalAdvance              Decimal              @default(0) @db.Decimal(10, 2)
  balanceDue                Decimal              @default(0) @db.Decimal(10, 2)
  otherDebits               Decimal              @default(0) @db.Decimal(10, 2)
  // Última alteração no registro (rollover de diária, consumo, fechamento...). Parte do "carimbo
  // de versão" do polling dos mapas — ver apps/web/src/lib/mapVersion.ts.
  updatedAt                 DateTime             @default(now()) @updatedAt
  fnrhRecords               FNRHRecord[]
  charges                   StayCharge[]
  primaryGuest              Guest                @relation(fields: [primaryGuestId], references: [id])
  room                      Room                 @relation(fields: [roomId], references: [id])
  reservation               Reservation?         @relation(fields: [reservationId], references: [id])
  tenant                    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consumptions              StayConsumption[]
  payments                  CashTransaction[]
  secondaryGuests           StayGuest[]
  debitTransfersOut         StayDebitTransfer[]  @relation("DebitTransferFrom")
  debitTransfersIn          StayDebitTransfer[]  @relation("DebitTransferTo")
  whatsappMessages          WhatsappMessage[]
  accountsReceivable        AccountsReceivable[]
  guestBalanceEntries       GuestBalanceEntry[]
  comandaSessions           ComandaSession[]

  @@map("stay_checkins")
}

// Registro de auditoria de cada transferência de débito entre quartos (menu "Transferência de
// Débitos" do Mapa Operacional, equivalente à tela WIN_TRANSFERENCIADEBITO do sistema legado):
// preserva de forma permanente quem transferiu, de qual hospedagem para qual e quanto — mesmo
// depois que ambas as hospedagens envolvidas já tiverem encerrado.
model StayDebitTransfer {
  id                String      @id @default(uuid())
  tenantId          String
  fromStayCheckinId String
  toStayCheckinId   String
  amount            Decimal     @db.Decimal(10, 2)
  operatorId        String?
  operatorName      String?
  createdAt         DateTime    @default(now())
  fromStay          StayCheckin @relation("DebitTransferFrom", fields: [fromStayCheckinId], references: [id])
  toStay            StayCheckin @relation("DebitTransferTo", fields: [toStayCheckinId], references: [id])
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("stay_debit_transfers")
}

model StayGuest {
  id            String      @id @default(uuid())
  stayCheckinId String
  name          String
  document      String?
  createdAt     DateTime    @default(now())
  stayCheckin   StayCheckin @relation(fields: [stayCheckinId], references: [id], onDelete: Cascade)

  @@map("stay_guests")
}

model StayConsumption {
  id            String       @id @default(uuid())
  stayCheckinId String
  productId     String?
  // Preenchido quando o consumo veio de uma comanda fechada do PDV do restaurante — permite
  // estornar o lançamento no quarto se a comanda for reaberta.
  comandaSessionId String?
  productName   String
  quantity      Decimal      @default(1) @db.Decimal(12, 3)
  unitPrice     Decimal      @db.Decimal(10, 2)
  totalPrice    Decimal      @db.Decimal(10, 2)
  posLocationId String?
  operatorId    String?
  operatorName  String?
  createdAt     DateTime     @default(now())
  product       Product?     @relation(fields: [productId], references: [id])
  posLocation   POSLocation? @relation(fields: [posLocationId], references: [id])
  stayCheckin   StayCheckin  @relation(fields: [stayCheckinId], references: [id], onDelete: Cascade)

  @@map("stay_consumptions")
}

model StayCharge {
  id            String      @id @default(uuid())
  stayCheckinId String
  referenceDate DateTime
  // Nome da tarifa vigente no momento da diária (ex.: "APTO STANDARD CASAL"), escolhida no
  // check-in e mantida em cada virada — nunca um rótulo fixo. Só muda quando o usuário troca a
  // tarifa da hospedagem em andamento.
  description   String      @default("Diária")
  // Marca este lançamento como diária de hospedagem (distingue de outros tipos de StayCharge que
  // possam existir no futuro), já que "description" agora guarda o nome real da tarifa e não pode
  // mais ser usado como identificador do tipo de lançamento.
  chargeType    String      @default("DAILY")
  amount        Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  stayCheckin   StayCheckin @relation(fields: [stayCheckinId], references: [id], onDelete: Cascade)

  @@unique([stayCheckinId, referenceDate])
  @@map("stay_charges")
}

model CorporateInvoice {
  id            String    @id @default(uuid())
  companyId     String
  invoiceNumber String    @unique
  totalAmount   Decimal   @db.Decimal(10, 2)
  dueDate       DateTime
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id])

  @@map("corporate_invoices")
}

// Ponto de Venda do hotel (recepção, restaurante, bar da piscina, frigobar da governança...).
// Cadastro único: é daqui que sai a lista do popup "P.D.V." do Lançamento de Consumo do Quarto,
// as colunas do Estoque Multi-PDV e o PDV das comandas do restaurante. (O antigo modelo
// SalesPoint foi unificado neste — ver histórico.)
model POSLocation {
  id           String            @id @default(uuid())
  tenantId     String
  name         String
  code         String?
  location     String?
  operator     String?
  isCentral    Boolean           @default(false)
  active       Boolean           @default(true)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks       POSProductStock[]
  transfersTo  StockTransfer[]   @relation("TransferToPOS")
  consumptions StayConsumption[]
  comandaSessions ComandaSession[]
  stockCounts  StockCount[]

  @@map("pos_locations")
}

model Product {
  id           String            @id @default(uuid())
  tenantId     String
  name         String
  // Referência / código interno do produto (Prod_Referencia no WinDev).
  reference    String?
  barcode      String?
  // category: coluna legada de texto livre. Substituída pela classificação cadastrada
  // (groupId / productTypeId). Mantida temporariamente e preenchida com o nome do grupo para
  // não quebrar telas que ainda a leem — será removida quando todas migrarem.
  category     String?
  // Classificação cadastrada (nunca texto livre) — ver telas de Grupos e Tipos de Produto.
  groupId       String?
  productTypeId String?
  // Unidade de medida (UN, CX, KG, L...) e marca — Prod_Unidade / Prod_Marca no WinDev.
  unit         String?           @default("UN")
  brand        String?
  costPrice    Decimal           @db.Decimal(10, 2)
  salePrice    Decimal           @db.Decimal(10, 2)
  generalStock Int               @default(0)
  minStock     Int               @default(5)
  maxStock     Int?
  imageUrl     String?
  // Perfil tributário para venda de industrializados (refrigerante, cerveja, água) no PDV do
  // restaurante — ver Dish.fiscalProfileId.
  fiscalProfileId String?
  posStocks     POSProductStock[]
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group         ProductGroup?    @relation(fields: [groupId], references: [id])
  productType   ProductType?     @relation(fields: [productTypeId], references: [id])
  transfers     StockTransfer[]
  consumptions  StayConsumption[]
  barcodes      ProductBarcode[]
  fiscalProfile FiscalProfile?   @relation(fields: [fiscalProfileId], references: [id])
  comandaItems  ComandaItem[]
  stockCountItems StockCountItem[]

  @@index([tenantId])
  @@map("products")
}

// Um produto pode ter vários códigos de barras vinculados (ex: embalagens/fornecedores
// diferentes do mesmo item); qualquer um deles, ao ser lido, resolve para o mesmo produto
// no Lançamento de Consumo do Quarto.
model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  code      String   @unique
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_barcodes")
}

model POSProductStock {
  id            String      @id @default(uuid())
  productId     String
  posLocationId String
  currentStock  Int         @default(0)
  posLocation   POSLocation @relation(fields: [posLocationId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, posLocationId])
  @@map("pos_product_stocks")
}

model StockTransfer {
  id              String      @id @default(uuid())
  productId       String
  toPosLocationId String
  quantity        Int
  transferredBy   String
  createdAt       DateTime    @default(now())
  product         Product     @relation(fields: [productId], references: [id])
  toPosLocation   POSLocation @relation("TransferToPOS", fields: [toPosLocationId], references: [id])

  @@map("stock_transfers")
}

// Uma sessão de contagem física de estoque feita no celular pelo funcionário (app satélite de
// contagem, login por telefone + senha). A contagem NUNCA altera saldo: ler código de barras e
// finalizar são operações de leitura. A única escrita de saldo é o confronto/ajuste feito por um
// admin no painel do assinante (status RECONCILED), sempre com registro em AuditLog.
model StockCount {
  id            String  @id @default(uuid())
  tenantId      String
  // null = contagem do estoque geral / almoxarifado (Product.generalStock).
  // preenchido = contagem do estoque fracionado daquele PDV (POSProductStock.currentStock).
  posLocationId String?
  // OPEN: em contagem no celular · DONE: funcionário finalizou · RECONCILED: assinante confrontou
  // e aplicou os ajustes · CANCELLED: descartada. Só pode existir uma contagem não-finalizada
  // (OPEN/DONE) por alvo (PDV ou geral) por vez — regra aplicada no código.
  status        String   @default("OPEN")
  startedByEmployeeId String?
  startedByName String
  note          String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?
  reconciledAt  DateTime?
  reconciledByName String?
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posLocation   POSLocation?  @relation(fields: [posLocationId], references: [id])
  startedBy     Employee?     @relation(fields: [startedByEmployeeId], references: [id])
  items         StockCountItem[]

  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id                  String  @id @default(uuid())
  countId             String
  // null quando o código de barras lido não foi encontrado no cadastro de produtos (notFound=true).
  productId           String?
  barcodeRead         String?
  // Nome do produto no cadastro no momento da leitura (ou o próprio código lido, se não encontrado).
  productNameSnapshot String   @default("")
  countedQty          Int      @default(0)
  notFound            Boolean  @default(false)
  notes               String?
  // Preenchidos no confronto pelo assinante:
  systemQtySnapshot   Int?      // saldo do sistema no instante em que o ajuste foi aplicado
  adjustedTo          Int?      // novo saldo gravado
  appliedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  count               StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product             Product?    @relation(fields: [productId], references: [id])

  // Uma linha por produto por contagem (leituras repetidas do mesmo produto somam em countedQty).
  // Itens "não encontrado" (productId null) não colidem — cada código desconhecido é agrupado por
  // barcodeRead no código.
  @@unique([countId, productId])
  @@index([countId])
  @@map("stock_count_items")
}

model CashRegister {
  id             String            @id @default(uuid())
  tenantId       String
  operatorId     String            @default("USR-001")
  operatorName   String
  openingBalance Decimal           @db.Decimal(10, 2)
  closingBalance Decimal?          @db.Decimal(10, 2)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  isOpen         Boolean           @default(true)
  tenant         Tenant            @relation("TenantCashRegisters", fields: [tenantId], references: [id], onDelete: Cascade)
  transactions   CashTransaction[]

  @@map("cash_registers")
}

model CashTransaction {
  id                String       @id @default(uuid())
  cashRegisterId    String
  type              String
  amount            Decimal      @db.Decimal(10, 2)
  description       String
  paymentMethod     String
  // Denormalizado no momento da criação a partir de PaymentMethod.sumsToCashRegister — evita
  // precisar de join para somar os totais físicos do caixa (sessão/geral/fechamento). Default
  // true preserva o comportamento de todos os lançamentos existentes (abertura, sangria etc).
  countsInCashTotal Boolean      @default(true)
  // Só usado pela transferência de débito entre quartos: o lançamento de baixa no quarto de
  // origem não representa nenhum dinheiro ainda (o dinheiro real só aparece quando o quarto de
  // destino pagar), então fica fora da lista de movimentações do turno inteiramente — não é
  // suficiente apenas excluí-lo dos totais, como ocorre com Conta Corrente/Parcelamento/Saldo do
  // Hóspede, que continuam visíveis na lista (só não somam).
  hiddenFromCashLog Boolean      @default(false)
  stayCheckinId     String?
  roomNumber        String?
  guestName         String?
  accountPlanId     String?
  createdAt         DateTime     @default(now())
  cashRegister      CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  stay              StayCheckin? @relation(fields: [stayCheckinId], references: [id])
  accountPlan       AccountPlan? @relation(fields: [accountPlanId], references: [id])

  @@map("cash_transactions")
}

// Configuração da instância uazapi (WhatsApp) do assinante — tela "Configuração do sistema >
// API Whatsapp". Cada tenant tem no máximo uma instância conectada (1:1). serverUrl/adminToken
// autenticam a criação/gestão da instância; instanceToken autentica o envio de mensagens e as
// demais operações da própria instância (chat/details, send/text, send/media, webhook, etc).
model UazapiSetting {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  serverUrl     String   @default("")
  adminToken    String   @default("")
  instanceId    String   @default("")
  instanceName  String   @default("")
  instanceToken String   @default("")
  status        String   @default("disconnected") // disconnected | connecting | connected | hibernated
  connected     Boolean  @default(false)
  qrCodeUrl     String?
  pairCode      String?
  webhookUrl    String   @default("")
  // Segredo aleatório por tenant, enviado como query param na URL do webhook registrada na uazapi
  // e validado em POST /api/uazapi/webhook/[tenantId] antes de processar qualquer evento — sem
  // isso, qualquer pessoa que soubesse/adivinhasse o tenantId conseguia forjar mensagens de
  // hóspede e acionar o Agente de IA.
  webhookSecret String?
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("uazapi_settings")
}

// Credenciais e configuração da transmissão eletrônica ao SNRHos (FNRH Digital, Ministério do
// Turismo/Serpro) por tenant. `enabled` começa em false por padrão — a transmissão automática
// (ver apps/worker/src/snrhosTransmit.ts) só roda para tenants que configurarem credenciais reais
// e habilitarem explicitamente, já que o envio ao governo tem efeito legal/tem multa associada.
model SNRHosSetting {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  environment    String   @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO
  apiUsername    String   @default("")
  apiPassword    String   @default("")
  cpfSolicitante String   @default("")
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("snrhos_settings")
}

// Configuração dos dois agentes de IA por tenant (Atendimento + Operacional). Separação rígida de
// controle: campos marcados "assinante" são editáveis pela tela de Configurações do próprio
// assinante; campos marcados "admin" só são editáveis pelo painel admin master
// (/admin/tenants/[id]) — nunca pela tela do assinante. Chave de API e modelo usado continuam
// globais, definidos por env var/infra, fora deste model. Ver PLANO_AGENTE_IA.md.
model AIAgentSetting {
  id       String @id @default(uuid())
  tenantId String @unique

  // --- Agente de Atendimento (assinante) ---
  enabled                     Boolean         @default(false) // atendimento via WhatsApp ligado/desligado
  autoConfirmReservations     Boolean         @default(false) // false = reserva feita pelo bot entra como PRE_RESERVATION
  allowAgentCancelReservation Boolean         @default(false) // permite o agente cancelar (soft-cancel) reserva a pedido do hóspede
  agentDisplayName            String? // nome com que o agente se apresenta no WhatsApp
  agentAvatarUrl              String? // foto de perfil do agente
  tonePreset                  AgentTonePreset @default(PROFISSIONAL)

  // --- Agente de Atendimento (admin master) ---
  systemPromptExtra  String? // prompt cru de personalidade/forma de atendimento, só o admin edita
  tokenQuotaOverride Int? // sobrescreve SaaSPlan.aiTokenQuota para este tenant, se definido
  blocked            Boolean @default(false) // força desligar os dois agentes, independente dos toggles do assinante

  // --- Agente Operacional (assinante) ---
  monitoringEnabled       Boolean                 @default(false)
  alertPhone              String? // número WhatsApp que recebe alertas do agente operacional
  operationalAutonomyMode OperationalAutonomyMode @default(ALERT_ONLY)

  // --- Base de Conhecimento (assinante) ---
  // Dias sem revisão até o Agente Operacional alertar que um tópico/entrada está desatualizado.
  knowledgeReviewIntervalDays Int     @default(90)
  // Opt-in dedicado (além de operationalAutonomyMode = AUTONOMOUS_LIMITED) para o Agente Operacional
  // corrigir sozinho valores desatualizados (preços, horários) na base quando divergirem do cadastro.
  // Escopo restrito definido em apps/worker/src/operationalAgent.ts (Fase 3). Padrão false.
  knowledgeAutoRewriteEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_agent_settings")
}

enum AgentTonePreset {
  FORMAL
  PROFISSIONAL
  DESCONTRAIDO
  DIRETO
}

// Controla se o Agente Operacional só alerta (padrão, mais seguro) ou pode agir sozinho em uma
// lista fechada de situações de baixo risco. Nenhuma ação autônoma de escrita deve ser implementada
// sem antes definir explicitamente, com o usuário, o escopo exato permitido — ver PLANO_AGENTE_IA.md.
enum OperationalAutonomyMode {
  ALERT_ONLY
  AUTONOMOUS_LIMITED
}

// Evita que o Agente Operacional (apps/worker/src/operationalAgent.ts) reenvie o mesmo alerta a
// cada ciclo do cron — um registro por (tenant, tipo de problema, entidade) enquanto o problema
// segue não resolvido; removido/expira quando o problema deixa de ser detectado.
model OperationalAlertLog {
  id             String    @id @default(uuid())
  tenantId       String
  issueType      String // ex: "SNRHOS_STUCK" | "PRECHECKIN_PENDING" | "ROOM_MAINTENANCE_STUCK" | "ROOM_DIRTY_STUCK" | "WHATSAPP_DISCONNECTED"
  entityId       String // id da entidade com problema (FNRHRecord, Reservation, Room, etc.) ou tenantId quando não há entidade específica
  firstAlertedAt DateTime  @default(now())
  lastAlertedAt  DateTime  @default(now())
  // A linha é criada ANTES do envio do WhatsApp e o @@unique abaixo é a trava que impede dois
  // ciclos concorrentes do worker de alertarem o mesmo problema (ver runOperationalAgent).
  // notifiedAt = instante em que o envio ao WhatsApp foi confirmado; null = ainda não enviado,
  // então os próximos ciclos re-tentam o envio (sem recriar a escalação no sino) até notifyAttempts
  // atingir o teto — evita ficar tentando pra sempre um alerta que nunca sai (ex.: WhatsApp caído).
  notifiedAt     DateTime?
  notifyAttempts Int       @default(0)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, issueType, entityId])
  @@map("operational_alert_logs")
}

enum EscalationSource {
  SUPPORT_AGENT
  OPERATIONAL_AGENT
}

// Fila de "precisa de um humano agora" alimentada pelos dois agentes de IA — diferente do
// AuditLog (que só registra fatos imutáveis do que o agente já fez), aqui existe um estado mutável
// (pendente → resolvida) que alimenta o sino de alerta visual/sonoro no Mapa de Quartos e Mapa de
// Reservas (ver apps/web/src/app/app/layout.tsx). Resolução é sempre manual (staff clica "resolver"),
// sem detecção automática nesta v1.
model HumanEscalation {
  id         String           @id @default(uuid())
  tenantId   String
  source     EscalationSource
  reason     String
  guestPhone String?
  entityType String?
  entityId   String?
  resolved   Boolean          @default(false)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolved])
  @@map("human_escalations")
}

// Histórico de mensagens WhatsApp da tela "Mensagens WhatsApp" do quarto ocupado — tanto o que o
// hotel enviou (resumo/consumo/extrato em PDF, texto avulso) quanto o que o hóspede respondeu,
// recebido via webhook da uazapi (POST /api/uazapi/webhook/[tenantId]).
model WhatsappMessage {
  id         String       @id @default(uuid())
  tenantId   String
  stayId     String?
  phone      String
  direction  String       @default("OUT") // "IN" (do hóspede) | "OUT" (enviada pelo hotel)
  type       String // "text" | "document" | "media"
  content    String? // texto da mensagem ou legenda (caption) do documento
  filename   String?
  mediaUrl   String? // URL do anexo (imagem/documento/áudio/vídeo) recebido do hóspede via webhook
  mimeType   String? // tipo bruto do anexo reportado pela uazapi (image, document, audio, video, ptt, sticker)
  senderName String? // nome de perfil do WhatsApp de quem enviou (preenchido em mensagens IN)
  externalId String? // messageid da uazapi — evita duplicar em reentregas de webhook
  read       Boolean      @default(true) // mensagens IN começam false até o operador abrir a conversa
  sentBy     String? // só em mensagens OUT: "AI" (agente de atendimento) | "HUMAN" (operador). null em mensagens IN.
  createdAt  DateTime     @default(now())
  // Bumpa quando a mensagem é marcada como lida — parte do "carimbo de versão" do polling dos
  // mapas, para o badge de não lidas do card do quarto não ficar preso (ver lib/mapVersion.ts).
  updatedAt  DateTime     @default(now()) @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stay       StayCheckin? @relation(fields: [stayId], references: [id], onDelete: SetNull)

  @@index([stayId])
  @@index([tenantId, direction, read])
  @@map("whatsapp_messages")
}

// Memória de longo prazo de uma conversa do agente de atendimento por WhatsApp (uma linha por
// tenant + telefone do hóspede). O histórico cru em WhatsappMessage continua sendo a fonte da
// verdade; aqui fica só a compressão das mensagens que já saíram da janela enviada ao modelo:
// `summary` guarda as nuances em texto e `state` o estado estruturado da negociação (datas,
// valores acordados, exigências, pendências). Atualizado por um "refold" periódico — ver
// apps/web/src/lib/aiAgent/conversationMemory.ts.
model ConversationMemory {
  id                String    @id @default(uuid())
  tenantId          String
  phone             String
  summary           String    @default("")
  state             Json?
  // createdAt da última WhatsappMessage já incorporada ao resumo — é o cursor do refold: só
  // mensagens posteriores a isso ainda contam como "não resumidas".
  summarizedThrough DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@map("conversation_memories")
}

model EmailSetting {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  smtpHost                  String   @default("smtp.gmail.com")
  smtpPort                  Int      @default(587)
  smtpSecure                String   @default("tls")
  smtpUser                  String   @default("")
  smtpPass                  String   @default("")
  fromName                  String   @default("Pousada Sol & Mar - Reservas")
  fromEmail                 String   @default("reserva@pousada.com.br")
  footerText                String?
